{% comment %}
  Rooted in Care, Shared in Moments Section
  Displays a title, subtitle, CTA button, and image gallery with edge shadows
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Figtree:wght@300;400;500;600;700&display=swap');

  .moments-section {
    background: {{ section.settings.section_bg_color }};
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px 20px;
  }

  .moments-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .moments-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .moments-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
    font-family: {{ section.settings.title_font }};
    line-height: 1.2;
  }

  .moments-title .italic-text {
    font-style: italic;
  }

  .moments-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    line-height: 1.7;
    color: {{ section.settings.subtitle_color }};
    max-width: 700px;
    margin: 0 auto {{ section.settings.subtitle_margin_bottom }}px auto;
    font-family: {{ section.settings.subtitle_font }};
  }

  .moments-cta {
    display: inline-block;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_roundedness }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    font-family: {{ section.settings.button_font }};
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .moments-cta:hover {
    background: {{ section.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  /* Gallery Container with Shadows */
  .moments-gallery-container {
    position: relative;
  }

  .moments-gallery-container::before,
  .moments-gallery-container::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 150px;
    pointer-events: none;
    z-index: 10;
    border-radius: 20px;
  }

  .moments-gallery-container::before {
    left: 0;
    background: linear-gradient(to right, rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }}) 0%, rgba(0, 0, 0, 0) 100%);
  }

  .moments-gallery-container::after {
    right: 0;
    background: linear-gradient(to left, rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }}) 0%, rgba(0, 0, 0, 0) 100%);
  }

  .moments-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ section.settings.gallery_gap }}px;
    margin-top: {{ section.settings.gallery_margin_top }}px;
  }

  .moments-image {
    border-radius: 20px !important;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .moments-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 20px !important;
  }

  @media (max-width: 968px) {
    .moments-section {
      padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px 20px;
    }

    .moments-title {
      font-size: calc({{ section.settings.title_size }}px * 0.8);
    }

    .moments-gallery-container::before,
    .moments-gallery-container::after {
      width: 100px;
    }

    .moments-gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .moments-title {
      font-size: calc({{ section.settings.title_size }}px * 0.7);
    }

    .moments-subtitle {
      font-size: calc({{ section.settings.subtitle_size }}px * 0.95);
    }

    .moments-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: calc({{ section.settings.gallery_gap }}px * 0.8);
    }

    .moments-gallery-container::before,
    .moments-gallery-container::after {
      display: none;
    }

    .moments-cta {
      padding: calc({{ section.settings.button_padding_vertical }}px * 0.9) calc({{ section.settings.button_padding_horizontal }}px * 0.9);
      font-size: calc({{ section.settings.button_font_size }}px * 0.95);
    }
  }
</style>

<section class="moments-section">
  <div class="moments-container">
    <!-- Header -->
    <div class="moments-header">
      <h2 class="moments-title">
        {{ section.settings.title_before_italic }}
        <span class="italic-text">{{ section.settings.title_italic }}</span>{{ section.settings.title_after_italic_1 }}
        <span class="italic-text">{{ section.settings.title_italic_2 }}</span>
      </h2>
      
      {% if section.settings.subtitle != blank %}
        <p class="moments-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="moments-cta">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <!-- Gallery with Shadow Container -->
    <div class="moments-gallery-container">
      <div class="moments-gallery">
        {% for block in section.blocks %}
          <div class="moments-image" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.alt_text }}
            {% else %}
              <img src="https://via.placeholder.com/400x400/E5E5E5/666666?text=Moment" alt="{{ block.settings.alt_text }}" loading="lazy">
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

