    { "type": "header", "content": "Roundedness" },
    { "type": "range", "id": "image_roundedness", "label": "Image roundedness", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "block_roundedness", "label": "Block roundedness", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_roundedness", "label": "Button roundedness", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 8 },
