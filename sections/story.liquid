      "settings": [
        { "type": "text", "id": "title_before", "label": "Title (before italic)", "default": "It Started with Our " },
        { "type": "text", "id": "title_emphasis", "label": "Title (italic word)", "default": "Nani" },
        { "type": "text", "id": "title_after", "label": "Title (after italic)" },
        { "type": "richtext", "id": "content", "label": "Content (desktop)", "default": "<p>Root Reboot was inspired by our founder's nani — the one who treated hair oiling like a moment of care, not a chore. Her routine was simple, intentional, and consistent, rooted in ingredients she trusted and a process she never rushed.</p>" },
        { "type": "richtext", "id": "content_mobile", "label": "Content (mobile – optional shorter text)", "info": "If set, this shows on mobile instead of the desktop content. Leave blank to use the same text." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "The Story Section",
      "blocks": [
        { "type": "story_block", "settings": { "title_before": "It Started with Our ", "title_emphasis": "Nani", "content": "<p>Root Reboot was inspired by our founder's nani — the one who treated hair oiling like a moment of care, not a chore.</p>", "content_mobile": "<p>Root Reboot was inspired by our founder's nani, who valued hair oiling.</p>" } },
