    { "type": "color", "id": "number_color", "label": "Number color", "default": "#D4776F" },
    { "type": "color", "id": "button_bg_color", "label": "Button background", "default": "#912643" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Typography" },
