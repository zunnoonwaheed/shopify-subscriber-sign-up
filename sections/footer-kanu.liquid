{% comment %}
  Footer Kanu – Edge-to-Edge (No left/right spacing)
  Top rounded, bottom straight, full width
  Save as: sections/footer-kanu.liquid
{% endcomment %}

<footer class="rr-footer" style="
  --page-bg: {{ section.settings.page_bg }};
  --footer-bg: {{ section.settings.footer_bg }};
  --text: {{ section.settings.text_color }};
  --muted: {{ section.settings.muted_color }};
  --border: {{ section.settings.border_color }};
  --btn-bg: {{ section.settings.button_bg }};
  --btn-text: {{ section.settings.button_text }};
  --heading-font: '{{ section.settings.heading_font }}', Georgia, serif;
  --body-font: '{{ section.settings.body_font }}', -apple-system, sans-serif;
  --logo-size: {{ section.settings.logo_size }}px;
">
  <div class="rr-footer__card">
    <div class="rr-footer__inner">

      <!-- TOP -->
      <div class="rr-footer__top">

        <!-- BRAND -->
        <div class="rr-footer__brand">
          {% if section.settings.logo != blank %}
            <div class="rr-footer__logo-wrapper">
              {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'rr-footer__logo', alt: shop.name }}
            </div>
          {% else %}
            <div class="rr-footer__logoText">{{ section.settings.brand_name | default: shop.name }}</div>
          {% endif %}

          {% if section.settings.tagline != blank %}
            <div class="rr-footer__tagline">
              {{ section.settings.tagline }}
            </div>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a class="rr-footer__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label }}
            </a>
          {% endif %}
        </div>

        <!-- MENUS -->
        <div class="rr-footer__menus">
          {% for block in section.blocks %}
            <div class="rr-footer__menu" {{ block.shopify_attributes }}>
              <div class="rr-footer__menuTitle">{{ block.settings.heading }}</div>

              {% if block.settings.menu != blank %}
                <ul class="rr-footer__list">
                  {% for link in block.settings.menu.links %}
                    <li>
                      <a class="rr-footer__link" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>

      </div>

      <div class="rr-footer__divider"></div>

      <!-- BOTTOM -->
      <div class="rr-footer__bottom">
        {% if section.settings.bottom_text != blank %}
          <div class="rr-footer__blurb">
            {{ section.settings.bottom_text }}
          </div>
        {% endif %}

        <div class="rr-footer__copyright">
          © {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name }}. All rights reserved.
        </div>
      </div>

    </div>
  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Figtree:wght@300;400;500;600;700&display=swap');

  /* REMOVE ALL SHOPIFY SECTION SPACING */
  #shopify-section-{{ section.id }} {
    padding: 0 !important;
    margin: 0 !important;
  }

  /* FOOTER WRAPPER - EDGE TO EDGE */
  .rr-footer {
    background: var(--page-bg);
    padding: 40px 30px 0px 30px;
    font-family: var(--body-font);
    margin: 0;
  }

  /* CARD – TOP ROUNDED, BOTTOM STRAIGHT, FULL WIDTH */
  .rr-footer__card {
    background: var(--footer-bg);
    width: 100%;
    max-width: none;
    margin: 0;
    border-radius: 24px 24px 0 0;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.04);
    overflow: hidden;
  }

  /* INNER - CONSTRAINED CONTENT */
  .rr-footer__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 50px 50px 40px;
  }

  /* TOP - ROW LAYOUT: BRAND LEFT, MENUS RIGHT */
  .rr-footer__top {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 80px;
    margin-bottom: 40px;
  }

  /* BRAND */
  .rr-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 260px;
    min-width: 260px;
    max-width: 260px;
    flex-shrink: 0;
  }

  .rr-footer__logo-wrapper {
    width: fit-content;
  }

  .rr-footer__logo {
    max-width: var(--logo-size);
    height: auto;
    display: block;
  }

  .rr-footer__logoText {
    font-family: var(--heading-font);
    font-size: 36px;
    font-weight: 600;
    color: var(--text);
  }

  .rr-footer__tagline {
    color: var(--muted);
    font-family: var(--body-font);
    font-size: 13.5px;
    line-height: 1.6;
    white-space: normal;
    max-width: 260px;
  }

  .rr-footer__tagline p {
    margin: 0;
  }

  /* CTA - BUTTON */
  .rr-footer__btn,
  .rr-footer__btn:hover,
  .rr-footer__btn:visited,
  .rr-footer__btn:focus,
  .rr-footer__btn:active {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-width: unset;
    max-width: max-content;
    padding: 10px 16px;
    background: var(--btn-bg);
    color: var(--btn-text);
    border-radius: 6px;
    font-family: var(--body-font);
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1;
    text-decoration: none !important;
    border: none;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    transition: all 0.2s ease;
    letter-spacing: 0.1px;
  }

  .rr-footer__btn:hover {
    transform: translateY(-1px);
    opacity: 0.92;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  /* MENUS - HORIZONTAL GRID */
  .rr-footer__menus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 200px));
    gap: 80px;
    justify-content: start;
    flex: 1;
  }

  .rr-footer__menuTitle {
    font-family: var(--body-font);
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 14px;
    color: var(--text);
  }

  .rr-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rr-footer__link {
    color: var(--muted);
    font-family: var(--body-font);
    font-size: 13.5px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .rr-footer__link:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* DIVIDER */
  .rr-footer__divider {
    height: 1px;
    background: var(--border);
    margin: 0 0 30px 0;
  }

  /* BOTTOM */
  .rr-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rr-footer__blurb {
    max-width: 800px;
    font-family: var(--body-font);
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
  }

  .rr-footer__blurb p {
    margin: 0;
  }

  .rr-footer__copyright {
    font-family: var(--body-font);
    font-size: 13px;
    color: var(--muted);
  }

  /* TABLET */
  @media (max-width: 1024px) {
    .rr-footer__inner {
      padding: 50px 40px 35px;
    }

    .rr-footer__top {
      gap: 50px;
    }

    .rr-footer__menus {
      gap: 40px;
    }
  }

  /* MOBILE */
  @media (max-width: 768px) {
    .rr-footer {
      padding: 30px 0 0;
    }

    .rr-footer__card {
      border-radius: 40px 40px 10px 10px;
    }

    .rr-footer__inner {
      padding: 35px 24px 30px;
    }

    .rr-footer__top {
      flex-direction: column;
      gap: 35px;
      margin-bottom: 35px;
    }

    .rr-footer__brand {
      width: 100%;
      min-width: unset;
      max-width: 100%;
    }

    .rr-footer__tagline {
      max-width: 100%;
    }

    .rr-footer__menus {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      width: 100%;
    }

    .rr-footer__blurb {
      font-size: 12.5px;
    }

    .rr-footer__copyright {
      font-size: 12.5px;
    }
  }

  @media (max-width: 480px) {
    .rr-footer__menus {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Kanu",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo size",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (if no logo)",
      "default": "Kanu Beauty"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Tagline",
      "default": "<p>Quick answers to help you choose<br>with confidence</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Root Reboot"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Bottom Section"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "<p>Rooted in tradition, crafted for modern hair care.<br>Kanu Beauty blends ancestral rituals with thoughtful formulation — no shortcuts, no quick fixes.</p>"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "Kanu Beauty"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Page background",
      "default": "#F6F2EE"
    },
    {
      "type": "color",
      "id": "footer_bg",
      "label": "Footer background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1E293B"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5A667A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider",
      "default": "#EFE7E1"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#7B2130"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        {
          "value": "Playfair Display",
          "label": "Playfair Display (Serif)"
        },
        {
          "value": "Georgia",
          "label": "Georgia (Serif)"
        },
        {
          "value": "Figtree",
          "label": "Figtree (Sans-serif)"
        }
      ],
      "default": "Playfair Display"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body text font",
      "options": [
        {
          "value": "Figtree",
          "label": "Figtree (Sans-serif)"
        },
        {
          "value": "Arial",
          "label": "Arial (Sans-serif)"
        },
        {
          "value": "Helvetica",
          "label": "Helvetica (Sans-serif)"
        }
      ],
      "default": "Figtree"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Kanu",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Product"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "About"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Legal"
          }
        }
      ]
    }
  ]
}
{% endschema %}