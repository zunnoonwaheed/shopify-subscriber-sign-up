<style>
.banner-enhanced {
  position: relative;
  overflow: hidden;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-enhanced__media {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.banner-enhanced__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

/* Show/hide desktop and mobile images */
.banner-enhanced__image--mobile {
  display: block;
}

.banner-enhanced__image--desktop {
  display: none;
}

@media screen and (min-width: 750px) {
  .banner-enhanced__image--mobile {
    display: none;
  }
  
  .banner-enhanced__image--desktop {
    display: block;
  }
}

/* Banner heights */
.banner-enhanced--adapt {
  min-height: 0;
}

.banner-enhanced--small {
  min-height: 40vh;
}

.banner-enhanced--medium {
  min-height: 50vh;
}

.banner-enhanced--large {
  min-height: 70vh;
}

@media screen and (min-width: 750px) {
  .banner-enhanced--small {
    min-height: 50vh;
  }

  .banner-enhanced--medium {
    min-height: 60vh;
  }

  .banner-enhanced--large {
    min-height: 80vh;
  }
}

/* Overlay */
.banner-enhanced__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 1;
}

/* Content */
.banner-enhanced__content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 4rem 2rem;
}

.banner-enhanced__wrapper {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
}

.banner-enhanced__box {
  max-width: 600px;
}

/* Position - Vertical */
.banner-enhanced--top .banner-enhanced__content {
  align-self: flex-start;
}

.banner-enhanced--middle .banner-enhanced__content {
  align-self: center;
}

.banner-enhanced--bottom .banner-enhanced__content {
  align-self: flex-end;
}

/* Position - Horizontal */
.banner-enhanced--left .banner-enhanced__wrapper {
  justify-content: flex-start;
}

.banner-enhanced--center .banner-enhanced__wrapper {
  justify-content: center;
}

.banner-enhanced--right .banner-enhanced__wrapper {
  justify-content: flex-end;
}

/* Alignment */
.banner-enhanced--align-left .banner-enhanced__box {
  text-align: left;
}

.banner-enhanced--align-center .banner-enhanced__box {
  text-align: center;
}

.banner-enhanced--align-right .banner-enhanced__box {
  text-align: right;
}

/* Typography */
.banner-enhanced__heading {
  margin: 0 0 1.5rem;
  color: #ffffff;
  line-height: 1.2;
  font-weight: 500;
  text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
}

.banner-enhanced__heading--h2 {
  font-size: clamp(2rem, 4vw, 2.5rem);
}

.banner-enhanced__heading--h1 {
  font-size: clamp(2.5rem, 5vw, 3.5rem);
}

.banner-enhanced__heading--h0 {
  font-size: clamp(3rem, 6vw, 4.5rem);
}

.banner-enhanced__heading--hxl {
  font-size: clamp(3.5rem, 7vw, 5.5rem);
}

.banner-enhanced__text {
  margin: 0 0 2rem;
  color: #ffffff;
  font-size: clamp(1rem, 2vw, 1.125rem);
  line-height: 1.6;
  text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.3);
}

.banner-enhanced__text--subtitle {
  font-size: clamp(1.125rem, 2.5vw, 1.25rem);
  font-weight: 400;
}

.banner-enhanced__text--uppercase {
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* Buttons */
.banner-enhanced__buttons {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.banner-enhanced__buttons--stacked {
  flex-direction: column;
  align-items: flex-start;
  max-width: 300px;
}

.banner-enhanced--align-center .banner-enhanced__buttons {
  justify-content: center;
}

.banner-enhanced--align-center .banner-enhanced__buttons--stacked {
  align-items: center;
  margin: 0 auto 1rem;
}

.banner-enhanced--align-right .banner-enhanced__buttons {
  justify-content: flex-end;
}

.banner-enhanced--align-right .banner-enhanced__buttons--stacked {
  align-items: flex-end;
  margin-left: auto;
}

.banner-enhanced__button {
  padding: 1rem 2.5rem;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 6px;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  white-space: nowrap;
  border: 2px solid transparent;
  letter-spacing: 0.02em;
}

.banner-enhanced__button--primary {
  background-color: #8B2942;
  color: #ffffff;
  border-color: #8B2942;
  box-shadow: 0 2px 8px rgba(139, 41, 66, 0.2);
}

.banner-enhanced__button--primary:hover {
  background-color: #6F1F35;
  border-color: #6F1F35;
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(139, 41, 66, 0.4);
}

.banner-enhanced__button--secondary {
  background-color: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
}

.banner-enhanced__button--secondary:hover {
  background-color: rgba(255, 255, 255, 0.15);
  border-color: #ffffff;
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(255, 255, 255, 0.2);
}

/* Subtext */
.banner-enhanced__subtext {
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.875rem;
  letter-spacing: 0.05em;
  font-style: italic;
  text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
}

/* Container background */
.banner-enhanced__box--with-bg {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 2.5rem;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.banner-enhanced__box--dark-bg {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.3) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 2.5rem;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

/* Mobile adjustments */
@media screen and (max-width: 749px) {
  .banner-enhanced__content {
    padding: 3rem 1.5rem;
  }

  .banner-enhanced__box {
    max-width: 100%;
  }

  .banner-enhanced__buttons {
    flex-direction: column;
    width: 100%;
  }

  .banner-enhanced__buttons--stacked {
    max-width: 100%;
  }

  .banner-enhanced__button {
    width: 100%;
    text-align: center;
  }
  
  .banner-enhanced__box--with-bg,
  .banner-enhanced__box--dark-bg {
    padding: 2rem 1.5rem;
  }
}

/* Animation effects */
@keyframes ambient-zoom {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.banner-enhanced--animate-ambient .banner-enhanced__image {
  animation: ambient-zoom 20s ease-in-out infinite;
}

.banner-enhanced--animate-zoom:hover .banner-enhanced__image {
  transform: scale(1.05);
  transition: transform 0.5s ease;
}
</style>

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  
  assign vertical_position = 'middle'
  assign horizontal_position = 'left'
  
  if section.settings.desktop_content_position contains 'top'
    assign vertical_position = 'top'
  elsif section.settings.desktop_content_position contains 'bottom'
    assign vertical_position = 'bottom'
  endif
  
  if section.settings.desktop_content_position contains 'center'
    assign horizontal_position = 'center'
  elsif section.settings.desktop_content_position contains 'right'
    assign horizontal_position = 'right'
  endif
-%}

<div class="banner-enhanced banner-enhanced--{{ section.settings.image_height }} banner-enhanced--{{ vertical_position }} banner-enhanced--{{ horizontal_position }} banner-enhanced--align-{{ section.settings.desktop_content_alignment }}{% if section.settings.image_behavior != 'none' %} banner-enhanced--animate-{{ section.settings.image_behavior }}{% endif %}">
  
  {%- comment -%} Background Images {%- endcomment -%}
  <div class="banner-enhanced__media">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          loading: 'lazy',
          fetchpriority: fetch_priority,
          width: section.settings.image.width,
          height: image_height,
          class: 'banner-enhanced__image banner-enhanced__image--desktop',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      }}
    {%- endif -%}
    
    {%- if section.settings.mobile_image != blank -%}
      {%- liquid
        assign mobile_image_height = section.settings.mobile_image.width | divided_by: section.settings.mobile_image.aspect_ratio
      -%}
      {{
        section.settings.mobile_image
        | image_url: width: 1500
        | image_tag:
          loading: 'lazy',
          fetchpriority: fetch_priority,
          width: section.settings.mobile_image.width,
          height: mobile_image_height,
          class: 'banner-enhanced__image banner-enhanced__image--mobile',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500'
      }}
    {%- elsif section.settings.image == blank -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg banner-enhanced__image' }}
    {%- endif -%}
    
    {%- if section.settings.image_overlay_opacity > 0 -%}
      <div class="banner-enhanced__overlay" style="opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}
  </div>
  
  {%- comment -%} Content {%- endcomment -%}
  <div class="banner-enhanced__content">
    <div class="banner-enhanced__wrapper page-width">
      <div class="banner-enhanced__box{% if section.settings.show_text_box %} banner-enhanced__box--{{ section.settings.text_box_style }}{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            
            {%- when 'heading' -%}
              <h2 class="banner-enhanced__heading banner-enhanced__heading--{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            
            {%- when 'text' -%}
              <div class="banner-enhanced__text banner-enhanced__text--{{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            
            {%- when 'buttons' -%}
              <div class="banner-enhanced__buttons{% if block.settings.button_layout == 'stacked' %} banner-enhanced__buttons--stacked{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label_1 != blank -%}
                  <a
                    {% if block.settings.button_link_1 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link_1 }}"
                    {% endif %}
                    class="banner-enhanced__button banner-enhanced__button--{% if block.settings.button_style_secondary_1 %}secondary{% else %}primary{% endif %}"
                  >
                    {{ block.settings.button_label_1 | escape }}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link_2 }}"
                    {% endif %}
                    class="banner-enhanced__button banner-enhanced__button--{% if block.settings.button_style_secondary_2 %}secondary{% else %}primary{% endif %}"
                  >
                    {{ block.settings.button_label_2 | escape }}
                  </a>
                {%- endif -%}
              </div>
            
            {%- when 'subtext' -%}
              <div class="banner-enhanced__subtext" {{ block.shopify_attributes }}>
                {{ block.settings.subtext }}
              </div>
              
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  
</div>

{% schema %}
{
  "name": "Image Banner Enhanced",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "📱 Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image (Required)",
      "info": "Recommended: 1920x800px or larger. Displays on tablets and desktop."
    },
    {
      "type": "header",
