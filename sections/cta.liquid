{% comment %}
  Ready to Begin CTA Section
  Full-width call-to-action with background image and buttons
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Figtree:wght@300;400;500;600;700&display=swap');

  .ready-cta-section {
    background: {{ section.settings.section_bg_color }};
    padding: 100px 20px 0 !important; /* top 100px, bottom 100px — hardcoded */
  }

  .ready-cta-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ready-cta-content {
    position: relative;
    background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: {{ section.settings.card_roundedness }}px;
    overflow: hidden;
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.content_padding }}px 40px;
    text-align: center;
  }

  .ready-cta-content::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ready-cta-inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  /* Heading — 32px fixed */
  .ready-cta-title {
    font-size: 32px !important;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.text_color }};
    margin: 0 0 12px 0 !important;
    padding: 0 !important;
    font-family: {{ section.settings.title_font }};
    line-height: 1.2 !important;
    letter-spacing: -0.01em;
  }

  /* Subtitle — 18px fixed */
  .ready-cta-subtitle {
    font-size: 18px !important;
    font-weight: {{ section.settings.subtitle_weight }};
    line-height: 1.65 !important;
    color: {{ section.settings.text_color }};
    margin: 0 0 32px 0 !important; /* subtitle → buttons: 32px */
    padding: 0 !important;
    opacity: 0.92;
    font-family: {{ section.settings.subtitle_font }};
  }

  .ready-cta-buttons {
    display: flex;
    gap: {{ section.settings.button_gap }}px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ready-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px !important;
    border-radius: {{ section.settings.button_roundedness }}px;
    text-decoration: none;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    font-family: {{ section.settings.button_font }};
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .ready-cta-button.primary {
    background: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text_color }};
    border: none;
  }

  .ready-cta-button.primary:hover {
    background: {{ section.settings.primary_button_hover_bg }};
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(145, 38, 67, 0.3);
  }

  .ready-cta-button.secondary {
    background: {{ section.settings.secondary_button_bg }};
    color: {{ section.settings.secondary_button_text_color }};
    border: none;
  }

  .ready-cta-button.secondary:hover {
    background: {{ section.settings.secondary_button_hover_bg }};
    color: {{ section.settings.secondary_button_hover_text }};
    transform: translateY(-2px);
  }

  @media (max-width: 968px) {
    .ready-cta-section {
      padding: 100px 20px 0 !important; /* keep 100px top/bottom on tablet */
    }

    .ready-cta-content {
      min-height: calc({{ section.settings.min_height }}px * 0.85);
      padding: calc({{ section.settings.content_padding }}px * 0.85) 32px;
    }

    .ready-cta-title {
      font-size: 26px !important;
      margin-bottom: 10px !important;
    }

    .ready-cta-subtitle {
      font-size: 16px !important;
      margin-bottom: 32px !important; /* keep 32px on tablet too */
    }
  }

  @media (max-width: 640px) {
    .ready-cta-section {
      padding: 100px 20px 0 !important; /* keep 100px top/bottom on mobile */
    }

    .ready-cta-content {
      min-height: calc({{ section.settings.min_height }}px * 0.75);
      padding: 44px 24px;
      border-radius: {{ section.settings.card_roundedness }}px;
      width: 100%;
      box-sizing: border-box;
      background-image: url('{{ section.settings.background_image | image_url: width: 1200 }}');
      background-size: cover;
      background-position: center;
    }

    .ready-cta-content::before {
      opacity: 0.35;
    }

    .ready-cta-inner {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ready-cta-title {
      font-size: 22px !important;
      margin-bottom: 10px !important;
    }

    .ready-cta-subtitle {
      font-size: 15px !important;
      margin-bottom: 32px !important; /* keep 32px on mobile */
      opacity: 0.95;
    }

    .ready-cta-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
      margin: 0 auto;
      gap: 12px;
    }

    .ready-cta-button {
      width: 100%;
      text-align: center;
      padding: 14px 24px !important;
    }

    .ready-cta-button.secondary {
      border: 1px solid rgba(0,0,0,0.1);
    }
  }
</style>

<section class="ready-cta-section">
  <div class="ready-cta-container">
    <div class="ready-cta-content" style="{% unless section.settings.background_image %}background-color: #c9b8a8;{% endunless %}">
      <div class="ready-cta-inner">
        <h2 class="ready-cta-title">
          {{ section.settings.title | default: 'Ready to Begin Your Root Reboot?' }}
        </h2>
        <p class="ready-cta-subtitle">
          {{ section.settings.subtitle | default: 'Start your routine with Root Reboot — crafted to nourish the scalp, strengthen roots, and support healthier hair through consistent care.' }}
        </p>
        <div class="ready-cta-buttons">
          {% if section.settings.primary_button_text != blank %}
            <a href="{{ section.settings.primary_button_link }}" class="ready-cta-button primary">
              {{ section.settings.primary_button_text }}
            </a>
          {% endif %}
          {% if section.settings.secondary_button_text != blank %}
            <a href="{{ section.settings.secondary_button_link }}" class="ready-cta-button secondary">
              {{ section.settings.secondary_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Ready to Begin CTA",
  "settings": [
    { "type": "header", "content": "Section Styling" },
    { "type": "color_background", "id": "section_bg_color", "label": "Section Background", "default": "linear-gradient(180deg, rgba(248, 245, 240, 1) 0%, rgba(255, 255, 255, 1) 100%)" },
    { "type": "range", "id": "card_roundedness", "label": "Card Roundedness", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "min_height", "label": "Minimum Height", "min": 300, "max": 600, "step": 10, "unit": "px", "default": 400 },
    { "type": "range", "id": "content_padding", "label": "Content Padding", "min": 40, "max": 120, "step": 5, "unit": "px", "default": 80 },
    { "type": "header", "content": "Background Image" },
    { "type": "image_picker", "id": "background_image", "label": "Background Image", "info": "Recommended: 2400x600px" },
    { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay Opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "header", "content": "Title" },
    { "type": "text", "id": "title", "label": "Title", "default": "Ready to Begin Your Root Reboot?" },
    { "type": "select", "id": "title_font", "label": "Title Font", "options": [{ "value": "'Playfair Display', serif", "label": "Playfair Display" }, { "value": "'Figtree', sans-serif", "label": "Figtree" }], "default": "'Playfair Display', serif" },
    { "type": "select", "id": "title_weight", "label": "Title Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "header", "content": "Subtitle" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Start your routine with Root Reboot — crafted to nourish the scalp, strengthen roots, and support healthier hair through consistent care." },
    { "type": "select", "id": "subtitle_font", "label": "Subtitle Font", "options": [{ "value": "'Playfair Display', serif", "label": "Playfair Display" }, { "value": "'Figtree', sans-serif", "label": "Figtree" }], "default": "'Figtree', sans-serif" },
    { "type": "select", "id": "subtitle_weight", "label": "Subtitle Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#F8F8F8" },
    { "type": "header", "content": "Buttons" },
    { "type": "select", "id": "button_font", "label": "Button Font", "options": [{ "value": "'Playfair Display', serif", "label": "Playfair Display" }, { "value": "'Figtree', sans-serif", "label": "Figtree" }], "default": "'Figtree', sans-serif" },
    { "type": "range", "id": "button_font_size", "label": "Button Font Size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "select", "id": "button_font_weight", "label": "Button Font Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "500" },
    { "type": "range", "id": "button_roundedness", "label": "Button Roundedness", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "button_gap", "label": "Gap Between Buttons", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Primary Button" },
    { "type": "text", "id": "primary_button_text", "label": "Primary Button Text", "default": "Shop Root Reboot" },
    { "type": "url", "id": "primary_button_link", "label": "Primary Button Link" },
    { "type": "color", "id": "primary_button_bg", "label": "Primary Button Background", "default": "#9a1c3d" },
    { "type": "color", "id": "primary_button_hover_bg", "label": "Primary Button Hover Background", "default": "#7a1f38" },
    { "type": "color", "id": "primary_button_text_color", "label": "Primary Button Text Color", "default": "#ffffff" },
    { "type": "header", "content": "Secondary Button" },
    { "type": "text", "id": "secondary_button_text", "label": "Secondary Button Text", "default": "View Ingredients" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary Button Link" },
    { "type": "color", "id": "secondary_button_bg", "label": "Secondary Button Background", "default": "#ffffff" },
    { "type": "color", "id": "secondary_button_text_color", "label": "Secondary Button Text Color", "default": "#9a1c3d" },
    { "type": "color", "id": "secondary_button_hover_bg", "label": "Secondary Button Hover Background", "default": "#912643" },
    { "type": "color", "id": "secondary_button_hover_text", "label": "Secondary Button Hover Text Color", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Ready to Begin CTA" }
  ]
}
{% endschema %}
