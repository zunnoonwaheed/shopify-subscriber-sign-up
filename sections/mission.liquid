{% comment %}
  Our Mission Section
  Save as: sections/our-mission.liquid
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Figtree:wght@300;400;500;600;700&display=swap');

  .mission-section {
    background: {{ section.settings.section_bg_color }};
    padding: 100px 20px 0 !important; /* top 100px, bottom 0 — hardcoded */
  }

  .mission-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .mission-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  .mission-title {
    font-size: 32px !important;
    font-weight: {{ section.settings.header_title_weight }};
    color: #2c2c2c;
    margin: 0 0 12px 0 !important;
    padding: 0 !important;
    font-family: {{ section.settings.header_title_font }};
    line-height: 1.2 !important;
    letter-spacing: -0.01em;
  }

  .mission-subtitle {
    font-size: {{ section.settings.header_text_size }}px;
    font-weight: {{ section.settings.header_text_weight }};
    line-height: 1.65;
    color: #5a5a5a;
    font-weight:400px !important;
    max-width: 720px;
    margin: 0 auto;
    font-family: {{ section.settings.header_text_font }};
  }

  .mission-content-wrapper {
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_roundedness }}px;
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.block_gap }}px;
  }

  .mission-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.block_column_gap }}px;
    align-items: center;
  }

  .mission-block.reverse { direction: rtl; }
  .mission-block.reverse > * { direction: ltr; }

  .mission-image {
    border-radius: {{ section.settings.image_roundedness }}px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    height: {{ section.settings.image_height }}px;
  }

  .mission-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mission-text h3 {
    font-size: 20px !important;
    font-weight: {{ section.settings.block_title_weight }};
    color: #2c2c2c;
    margin: 0 0 8px 0 !important;
    padding: 0 !important;
    font-family: {{ section.settings.block_title_font }};
    line-height: 1.3 !important;
    letter-spacing: -0.01em;
  }

  .mission-text p {
    font-size: 18px !important;
    font-weight: {{ section.settings.block_text_weight }};
    line-height: 1.6 !important;
    color: #5a5a5a;
    margin: 0 !important;
    padding: 0 !important;
    font-family: {{ section.settings.block_text_font }};
  }

  .mission-dots { display: none; }

  /* ── MOBILE ── */
  @media (max-width: 968px) {
    .mission-section {
      padding: 100px 0 0 !important; /* mobile: same 100px top, 0 bottom */
      overflow: hidden;
    }

    .mission-container { padding: 0 24px; }

    .mission-header {
      text-align: center;
      margin-bottom: 0;
    }

    .mission-title {
      font-size: 26px !important;
      margin-bottom: 10px !important;
    }

    .mission-subtitle {
      text-align: center;
      max-width: 520px;
      margin: 0 auto 28px;
    }

    .mission-content-wrapper {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      padding: 0 24px 12px;
      margin: 0 -24px;
      scrollbar-width: none;
      background: transparent;
      border-radius: 0;
      box-shadow: none;
    }

    .mission-content-wrapper::-webkit-scrollbar { display: none; }

    .mission-block {
      flex: 0 0 min(340px, calc(100vw - 48px));
      min-width: min(340px, calc(100vw - 48px));
      max-width: 340px;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      display: flex !important;
      flex-direction: column !important;
      gap: 16px;
      text-align: center;
      align-items: center;
      padding: 0;
      background: transparent;
      box-shadow: none;
      border: none;
      box-sizing: border-box;
    }

    .mission-block.reverse { direction: ltr; }

    .mission-image {
      width: 100%;
      aspect-ratio: 4 / 3;
      height: auto !important;
      border-radius: {{ section.settings.image_roundedness }}px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .mission-text {
      text-align: center;
      width: 100%;
      padding: 0 4px;
    }

    .mission-text h3 {
      font-size: 18px !important;
      margin: 0 0 6px 0 !important;
      text-align: center !important;
    }

    .mission-text p {
      font-size: 15px !important;
      text-align: center !important;
    }

    .mission-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 16px;
    }

    .mission-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: rgba(0,0,0,0.18);
      border: none; padding: 0;
      cursor: pointer; flex-shrink: 0;
      transition: background 0.25s ease, transform 0.25s ease;
    }

    .mission-dot--active {
      background: #a0475a;
      transform: scale(1.35);
    }
  }

  @media (max-width: 640px) {
    .mission-section { padding: 100px 0 0 !important; }
    .mission-container { padding: 0 16px; }

    .mission-content-wrapper {
      margin: 0 -16px;
      padding: 0 16px 10px;
      gap: 12px;
    }

    .mission-block {
      flex: 0 0 min(340px, calc(100vw - 32px));
      min-width: min(340px, calc(100vw - 32px));
      gap: 14px;
    }

    .mission-title { font-size: 22px !important; margin-bottom: 10px !important; }
    .mission-subtitle { max-width: 100%; padding: 0 4px; margin-bottom: 24px; }
    .mission-text h3 { font-size: 17px !important; margin: 0 0 5px 0 !important; }
    .mission-text p { font-size: 14px !important; }
  }
</style>

<section class="mission-section">
  <div class="mission-container">

    <div class="mission-header">
      <h2 class="mission-title">{{ section.settings.title | default: 'Our Mission' }}</h2>
      <p class="mission-subtitle">{{ section.settings.subtitle | default: 'Kanu exists to reclaim the beauty of heritage — not as nostalgia, but as something living, modern, and powerful today.' }}</p>
    </div>

    <div class="mission-content-wrapper" id="mission-list-{{ section.id }}">
      {% assign block_index = 0 %}
      {% for block in section.blocks %}
        <div class="mission-block {% if block.settings.image_position == 'right' %}reverse{% endif %}" data-index="{{ block_index }}" {{ block.shopify_attributes }}>
          <div class="mission-image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% else %}
              <img src="https://via.placeholder.com/600x450/E5E5E5/666666?text=Mission+Image" alt="{{ block.settings.title }}" loading="lazy">
            {% endif %}
          </div>
          <div class="mission-text">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.content }}</p>
          </div>
        </div>
        {% assign block_index = block_index | plus: 1 %}
      {% endfor %}
    </div>

    {% assign block_count = section.blocks | size %}
    {% if block_count > 1 %}
    <div class="mission-dots" id="mission-dots-{{ section.id }}" aria-hidden="true">
      {% for i in (1..block_count) %}
        <button
          class="mission-dot{% if forloop.first %} mission-dot--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {% endfor %}
    </div>
    {% endif %}

  </div>
</section>

<script>
(function() {
  function initMissionDots(sectionId) {
    var list = document.getElementById('mission-list-' + sectionId);
    var dotsContainer = document.getElementById('mission-dots-' + sectionId);
    if (!list || !dotsContainer) return;

    var dots = dotsContainer.querySelectorAll('.mission-dot');
    var cards = list.querySelectorAll('.mission-block');
    if (!dots.length || !cards.length) return;

    var activeIndex = 0;

    function setActiveDot(index) {
      if (index === activeIndex) return;
      dots[activeIndex].classList.remove('mission-dot--active');
      activeIndex = index;
      dots[activeIndex].classList.add('mission-dot--active');
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(dot.getAttribute('data-index'), 10);
        var card = cards[idx];
        if (card) {
          list.scrollTo({ left: card.offsetLeft - list.offsetLeft, behavior: 'smooth' });
        }
      });
    });

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var idx = parseInt(entry.target.getAttribute('data-index'), 10);
          if (!isNaN(idx)) setActiveDot(idx);
        }
      });
    }, { root: list, threshold: 0.6 });

    cards.forEach(function(card) { observer.observe(card); });
  }

  function init() {
    document.querySelectorAll('[id^="mission-list-"]').forEach(function(el) {
      var id = el.id.replace('mission-list-', '');
      initMissionDots(id);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('shopify:section:load', init);
})();
</script>

{% schema %}
{
  "name": "Our Mission",
  "settings": [
    { "type": "header", "content": "Section Styling" },
    { "type": "color_background", "id": "section_bg_color", "label": "Section Background", "default": "linear-gradient(180deg, rgba(248, 245, 240, 1) 0%, rgba(255, 255, 255, 1) 100%)" },
    { "type": "color", "id": "card_bg_color", "label": "Content Card Background", "default": "#faf8f4" },
    { "type": "range", "id": "card_roundedness", "label": "Card Roundedness", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "image_roundedness", "label": "Image Roundedness", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Spacing & Dimensions" },
    { "type": "range", "id": "header_margin_bottom", "label": "Header → Cards gap", "min": 20, "max": 80, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "card_padding", "label": "Card Inner Padding", "min": 30, "max": 80, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "block_gap", "label": "Gap Between Blocks", "min": 20, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "block_column_gap", "label": "Gap Between Image & Text", "min": 20, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "image_height", "label": "Image Height", "min": 200, "max": 700, "step": 10, "unit": "px", "default": 250 },
    { "type": "header", "content": "Header Typography" },
    { "type": "select", "id": "header_title_font", "label": "Header Title Font", "options": [{ "value": "'Playfair Display', serif", "label": "Playfair Display" }, { "value": "'Figtree', sans-serif", "label": "Figtree" }], "default": "'Playfair Display', serif" },
    { "type": "select", "id": "header_title_weight", "label": "Header Title Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "select", "id": "header_text_font", "label": "Subtitle Font", "options": [{ "value": "'Playfair Display', serif", "label": "Playfair Display" }, { "value": "'Figtree', sans-serif", "label": "Figtree" }], "default": "'Figtree', sans-serif" },
    { "type": "range", "id": "header_text_size", "label": "Subtitle Size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "select", "id": "header_text_weight", "label": "Subtitle Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "header", "content": "Block Typography" },
    { "type": "select", "id": "block_title_font", "label": "Block Title Font", "options": [{ "value": "'Playfair Display', serif", "label": "Playfair Display" }, { "value": "'Figtree', sans-serif", "label": "Figtree" }], "default": "'Playfair Display', serif" },
    { "type": "select", "id": "block_title_weight", "label": "Block Title Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "select", "id": "block_text_font", "label": "Block Content Font", "options": [{ "value": "'Playfair Display', serif", "label": "Playfair Display" }, { "value": "'Figtree', sans-serif", "label": "Figtree" }], "default": "'Figtree', sans-serif" },
    { "type": "range", "id": "block_text_size", "label": "Block Content Size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 18 },
    { "type": "select", "id": "block_text_weight", "label": "Block Content Weight", "options": [{ "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "title", "label": "Title", "default": "Our Mission" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Kanu exists to reclaim the beauty of heritage — not as nostalgia, but as something living, modern, and powerful today. We create rituals that feel familiar, work consistently, and honor the roots we come from." }
  ],
  "blocks": [
    {
      "type": "mission_block",
      "name": "Mission Block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_position", "label": "Image Position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
        { "type": "text", "id": "title", "label": "Title", "default": "Mission Block Title" },
        { "type": "textarea", "id": "content", "label": "Content", "default": "Mission block content goes here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Mission",
      "blocks": [
        { "type": "mission_block", "settings": { "image_position": "left", "title": "Why Kanu Exists", "content": "We built Kanu for those who want care that feels intentional, products inspired by tradition, refined through thoughtful formulation, and made for everyday use without shortcuts." } },
        { "type": "mission_block", "settings": { "image_position": "right", "title": "Reclaiming Heritage, Forward", "content": "Heritage isn't something to leave behind, it's something to carry forward. Root Reboot celebrates ancestral rituals and brings them into modern routines, with respect, simplicity, and consistency." } },
        { "type": "mission_block", "settings": { "image_position": "left", "title": "Consistency Over Quick Fixes", "content": "We don't believe in overnight promises. We believe in showing up consistently, nourishing the scalp, strengthening roots, and letting real results build naturally over time." } }
      ]
    }
  ]
}
{% endschema %}
