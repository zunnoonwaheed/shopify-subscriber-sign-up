x;\n      margin:0 0 12px;\n      font-style:italic;         \/* matches the “soft” feel in screenshot *\/\n    }\n    .pd-topline .dot{\n      color:var(--dot);\n      padding:0 8px;\n      font-style:normal;\n    }\n\n    \/* section headings (small, NOT huge) *\/\n    .pd-h{\n      font-family:\"Playfair Display\", Georgia, serif;\n      font-size:var(--title);\n      font-weight:600;\n      line-height:1.25;\n      margin:0 0 var(--title-gap);\n      color:var(--ink);\n    }\n\n    \/* body *\/\n    .pd-p,\n    .pd-lines,\n    .pd-ingredients{\n      font-family:\"Figtree\", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n      font-size:var(--body);\n      line-height:var(--line);\n      color:var(--text);\n      margin:0 0 var(--para-gap);\n    }\n\n    \/* Made with list (tight, no bullets, same line style) *\/\n    .pd-lines{\n      list-style:none;\n      padding:0;\n      margin:0 0 var(--block-gap);\n    }\n    .pd-lines li{ margin:0; }\n    .pd-lines strong{\n      font-weight:600;\n      color:var(--ink);\n    }\n\n    \/* block separation *\/\n    .pd-block{ margin:0 0 var(--block-gap); }\n    .pd-block:last-child{ margin-bottom:0; }\n\n    \/* Optional: if you paste into Shopify product description area, keep it clean *\/\n    .pd-wrap a{ color:inherit; text-decoration:underline; text-underline-offset:2px; }\n\n    \/* Mobile: still compact *\/\n    @media (max-width:520px){\n      .pd-wrap{ max-width:100%; }\n    }\n  <\/style>\n<\/head>\n\n<body>\n  <section class=\"pd-wrap\">\n    <p class=\"pd-topline\">\n      Free shipping<span class=\"dot\">•<\/span>Easy returns<span class=\"dot\">•<\/span>Secure checkout\n    <\/p>\n\n    <div class=\"pd-block\">\n      <h3 class=\"pd-h\">Product Description<\/h3>\n      <p class=\"pd-p\">\n        A luxurious, small-batch blend inspired by timeless South Asian hair rituals — where oiling\n        was an act of both care and connection. Root Reboot is designed to nourish the scalp,\n        support stronger roots, and help restore balance through consistent use.\n      <\/p>\n    <\/div>\n\n    <div class=\"pd-block\">\n      <h3 class=\"pd-h\">Made with<\/h3>\n      <ul class=\"pd-lines\">\n        <li><strong>Jojoba Oil<\/strong> — helps moisturize the scalp and support a balanced feel<\/li>\n        <li><strong>Amla Extract<\/strong> — traditionally used to nourish and promote natural shine<\/li>\n        <li><strong>Rosemary<\/strong> — known for supporting healthier-looking hair growth<\/li>\n        <li><strong>Castor Oil<\/strong> — commonly used to boost shine and help seal in moisture<\/li>\n        <li><strong>Black Seed Oil<\/strong> — traditionally used to soothe and comfort the scalp<\/li>\n      <\/ul>\n    <\/div>\n\n    <div class=\"pd-block\">\n      <h3 class=\"pd-h\">How to use<\/h3>\n      <p class=\"pd-p\">\n        Apply a few drops directly to your scalp and massage gently. Leave on for 30–60 minutes\n        (or overnight), then wash as usual. Use 2–3 times a week for best results.\n      <\/p>\n    <\/div>\n\n    <div class=\"pd-block\">\n      <h3 class=\"pd-h\">Ingredients<\/h3>\n      <p class=\"pd-ingredients\">\n        Simmondsia Chinensis Seed Oil, Ricinus Communis Seed Oil, Nigella Sativa Seed Oil,\n        Rosmarinus Officinalis Leaf Extract, Emblica Officinalis Fruit Extract, Tocopherol,\n        Jasminum Officinale Oil\n      <\/p>\n    <\/div>\n  <\/section>\n<\/body>\n<\/html>"}},"collapsible_tab_hTNyER":{"type":"collapsible_tab","settings":{"heading":"Product Description","icon":"check_mark","content":"<p>A luxurious, small-batch blend inspired by timeless South Asian hair rituals where oiling was an act of both care and connection. Root Reboot is designed to nourish the scalp, support stronger roots, and help restore balance through consistent use.<\/p>","page":""}},"collapsible_tab_XJKnMq":{"type":"collapsible_tab","settings":{"heading":"Made with","icon":"check_mark","content":"<ul><li><strong>Jojoba Oil<\/strong>