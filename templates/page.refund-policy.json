{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"padding_top":56,"padding_bottom":28}},"custom_liquid_bWp3Cy":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Refund Policy<\/title>\n  <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Playfair+Display:wght@400&family=Figtree:wght@400;600&display=swap\" rel=\"stylesheet\">\n  <style>\n    .privacy-container {\n      max-width: 820px;\n      margin: 50px auto;\n      padding: 60px 50px;\n      background: #ffffff;\n      border-radius: 12px;\n      box-shadow: 0 6px 20px rgba(0,0,0,0.05);\n      font-family: \"Figtree\", Arial, sans-serif;\n      color: rgba(0,0,0,0.6);\n      line-height: 1.5;\n    }\n\n    .privacy-main-heading {\n      text-align: center;\n      font-size: 30px !important;\n      margin-bottom: 1.5em !important;\n      font-family: \"Playfair Display\", Georgia, serif !important;\n      font-weight: 400 !important;\n      color: rgba(0,0,0,0.8) !important;\n      line-height: 1.5 !important;\n    }\n\n    .privacy-text {\n      margin-bottom: 1.8em;\n      font-size: 16px !important;\n      font-family: \"Figtree\", Arial, sans-serif !important;\n      line-height: 1.5 !important;\n      color: rgba(0,0,0,0.6) !important;\n    }\n\n    .privacy-link {\n      color: #1a73e8;\n      text-decoration: none;\n    }\n    .privacy-link:hover {\n      text-decoration: underline;\n    }\n\n    @media (max-width: 768px) {\n      .privacy-container { padding: 40px 20px; }\n      .privacy-main-heading { font-size: 30px !important; margin-bottom: 2em; }\n      .privacy-text { font-size: 16px !important; }\n    }\n\n    @media (max-width: 480px) {\n      .privacy-container { padding: 30px 15px; }\n      .privacy-main-heading { font-size: 26px !important; margin-bottom: 1.8em; }\